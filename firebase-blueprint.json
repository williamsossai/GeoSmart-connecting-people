        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "maxLength": 80
        },
        "otherNames": {
          "type": "string",
          "maxLength": 120
        },
        "gender": {
          "type": "string",
          "enum": ["female", "male", "non_binary", "another", "unspecified"],
          "maxLength": 20
        },
        "originSummary": {
          "type": "string",
          "maxLength": 200
        },
        "currentResidenceSummary": {
          "type": "string",
          "maxLength": 200
        },
        "placeOfOriginName": {
          "type": "string",
          "maxLength": 120
        },
        "placeOfOriginCountry": {
          "type": "string",
          "maxLength": 100
        },
        "sharedPlacesCount": {
          "type": "integer"
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared", "public"],
          "maxLength": 16
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "numericId",
        "displayName",
        "firstName",
        "lastName",
        "otherNames",
        "gender",
        "originSummary",
        "currentResidenceSummary",
        "placeOfOriginName",
        "placeOfOriginCountry",
        "sharedPlacesCount",
        "visibility",
        "updatedAt"
      ]
    },
