  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User accounts and private identity profiles (owner-only or admin)."
    },
    "/sharedProfiles/{uid}": {
      "schema": { "$ref": "#/entities/SharedProfile" },
      "description": "Non-PII shareable summaries readable by authenticated users only when visibility is shared or public."
    },
    "/users/{uid}/places/{placeId}": {
      "schema": { "$ref": "#/entities/PlaceConnection" },
      "description": "User place connections."
    },
    "/users/{uid}/communities/{communityId}": {
      "schema": { "$ref": "#/entities/CommunityConnection" },
      "description": "Private user community connections."
    },
    "/users/{uid}/familyMembers/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMemberRecord" },
      "description": "User family member nodes and relationships."
    },
    "/users/{uid}/activityEvents/{eventId}": {
      "schema": { "$ref": "#/entities/ActivityEvent" },
      "description": "User activity and privacy change history."
    },
    "/users/{uid}/stories/{storyId}": {
      "schema": { "$ref": "#/entities/FamilyStoryRecord" },
      "description": "User family story metadata."
    },
    "/familyInvitations/{inviteId}": {
      "schema": { "$ref": "#/entities/FamilyInvitation" },
      "description": "Verified-email family invitations queryable only by inviter or matching verified invitee."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Trusted administrator directory (read-only to clients)."
    },
    "/adminLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAccessLog" },
      "description": "Immutable platform administrator audit logs."
    }
  }
}
