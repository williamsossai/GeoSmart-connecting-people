        "acceptedByUid": {
          "type": "string",
          "maxLength": 128
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "numericId",
        "inviterUid",
        "inviterName",
        "inviterFirstName",
        "inviterLastName",
        "inviterGender",
        "memberId",
        "memberNumericId",
        "personName",
        "inviteeEmail",
        "inviteCodeHash",
        "relationshipType",
        "gender",
        "inviterFamilyCount",
        "status",
