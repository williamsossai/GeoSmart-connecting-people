{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account, core person identity, profile details, and notification preferences (PII isolated to owner or admin).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "numericId": {
          "type": "integer",
          "description": "Deterministic positive integer ID for UI compatibility"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name",
          "maxLength": 120
        },
        "firstName": {
          "type": "string",
          "description": "First name",
          "minLength": 1,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "description": "Last name",
          "maxLength": 80
        },
        "otherNames": {
          "type": "string",
          "description": "Middle or other names",
          "maxLength": 120
        },
        "gender": {
          "type": "string",
          "description": "Gender",
          "enum": ["female", "male", "non_binary", "another", "unspecified"],
          "maxLength": 20
        },
        "isLiving": {
          "type": "boolean",
          "description": "Whether the person is living"
        },
        "bio": {
          "type": "string",
          "description": "Personal biography",
          "maxLength": 1500
        },
        "currentResidenceSummary": {
          "type": "string",
          "description": "Current residence summary",
          "maxLength": 200
        },
        "originSummary": {
          "type": "string",
          "description": "Personal origin summary",
          "maxLength": 200
        },
        "visibility": {
          "type": "string",
          "description": "Profile visibility level",
          "enum": ["private", "shared", "public"],
          "maxLength": 16
        },
        "role": {
          "type": "string",
          "description": "Authorization role",
          "enum": ["user", "admin"],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended"],
          "maxLength": 16
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether onboarding has been completed"
        },
        "alertsEnabled": {
          "type": "boolean",
          "description": "Invitation and kinship alert notifications preference"
        },
        "activityReadAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when invitation activity was last marked read"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "uid",
        "numericId",
        "email",
        "displayName",
        "firstName",
        "lastName",
        "otherNames",
        "gender",
        "isLiving",
        "bio",
        "currentResidenceSummary",
        "originSummary",
        "visibility",
        "role",
        "status",
        "onboardingCompleted",
        "alertsEnabled",
        "activityReadAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "SharedProfile": {
      "title": "SharedProfile",
      "description": "Non-PII shareable profile summary for connected family members when profile visibility is shared or public.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
