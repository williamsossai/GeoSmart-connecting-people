# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required: generate a unique random value of at least 32 bytes for this server.
# Never commit or share the real value. Changing it invalidates local app sessions.
SESSION_SECRET="GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES"

# Optional comma-separated Firebase UIDs explicitly provisioned as administrators.
# Never grant administrator access based on an unverified email or signup order.
ADMIN_UIDS=""

# Hosting platforms such as Cloud Run provide PORT automatically.
PORT="3000"

# Required for local account storage. Copy these settings into .env.local.
SQL_HOST="127.0.0.1"
SQL_USER="YOUR_POSTGRES_USER"
SQL_PASSWORD="YOUR_POSTGRES_PASSWORD"
SQL_DB_NAME="geosmart"

# Required only for Drizzle schema commands (for example, drizzle-kit push).
SQL_ADMIN_USER="YOUR_POSTGRES_ADMIN_USER"
SQL_ADMIN_PASSWORD="YOUR_POSTGRES_ADMIN_PASSWORD"

# Alternative: Supabase PostgreSQL connection string from Connect > Session pooler.
# Download the Supabase CA certificate from Database > Settings to
# certs/supabase-prod-ca-2021.crt. URL-encode reserved password characters.
# When DATABASE_URL is set, it takes precedence over the SQL_* settings above.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-prod-ca-2021.crt"
